<Window x:Class="Proyecto_1.Window4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proyecto_1"
        mc:Ignorable="d"
        Title="Window4" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DataGrid Grid.Column="0" Margin="40"/>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="Black" BorderThickness="2" Grid.Row="0" Margin="10">
                <DataGrid Margin="30"/>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Hacer visible" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0" Margin="10"/>
                <Button Content="Validar" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" Margin="10"/>
                <Button Content="Hacer invisible" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="2" Margin="10"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
