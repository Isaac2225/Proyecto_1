<Window x:Class="Proyecto_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proyecto_1"
        Loaded="Window_Loaded" Title="MainWindow" Height="450" Width="800"
        WindowState="Maximized" Background="#F3F5F9" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- Colores -->
        <SolidColorBrush x:Key="Primary" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="PrimaryPressed" Color="#1E40AF"/>
        <SolidColorBrush x:Key="BorderColor" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="TextColor" Color="#1F2937"/>

        <!-- Texto -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>

        <!-- Botones -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de icono (el de info del DataGrid) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="6,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <!-- ListBox de sugerencias -->
        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Log in" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" Click="Button_Click_Log"/>
                <Button Content="Sign in" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" Click="Button_Click_Sign"/>
            </StackPanel>
        </Border>

        <!-- Buscador -->
        <Border Grid.Row="1" Margin="20,20,20,10" Padding="20" Background="White" CornerRadius="10"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="10" VerticalAlignment="Center">
                    <TextBlock Text="Origen" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="10"/>
                    <TextBox TextChanged="txtOrigen_TextChanged" x:Name="txtOrigen" Width="200" HorizontalAlignment="Center"
                             Margin="10"/>
                    <Popup x:Name="popupSugerencias" Placement="Bottom" StaysOpen="False"
                           PlacementTarget="{Binding ElementName=txtOrigen}">
                        <ListBox SelectionChanged="lstSugerencias_SelectionChanged" x:Name="lstSugerencias" MaxHeight="150"
                                 DisplayMemberPath="Nombre" Width="{Binding ActualWidth, ElementName=txtOrigen}"/>
                    </Popup>
                    <ComboBox x:Name="cboHoraSalida" Width="200" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="10" VerticalAlignment="Center">
                    <TextBlock Text="Destino" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="10"/>
                    <TextBox TextChanged="txtDestino_TextChanged" x:Name="txtDestino" Width="200" HorizontalAlignment="Center"
                             Margin="10"/>
                    <Popup x:Name="popupSugerencias2" Placement="Bottom" StaysOpen="False"
                           PlacementTarget="{Binding ElementName=txtDestino}">
                        <ListBox SelectionChanged="lstSugerencias2_SelectionChanged" x:Name="lstSugerencias2" MaxHeight="150"
                                 DisplayMemberPath="Nombre" Width="{Binding ActualWidth, ElementName=txtDestino}"/>
                    </Popup>
                    <ComboBox x:Name="cboLlegada" Width="200" HorizontalAlignment="Center"/>
                </StackPanel>
                <Button Click="Button_Click" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="20" Padding="28,10">Buscar</Button>
            </Grid>
        </Border>

        <!-- Lista de trayectos -->
        <DataGrid x:Name="dgTrayecto" Grid.Row="2" Margin="20,10,20,20" AutoGenerateColumns="False" Visibility="Visible">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource IconButton}" Background="Transparent" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Click="Button_Click_info">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="16"
                                           Foreground="{StaticResource Primary}"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Identificador" Width="100" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="Nombre" Width="*" Binding="{Binding Nombre}"/>
                <DataGridTextColumn Header="Nombre de Creación" Width="*" Binding="{Binding FechaCreacion, StringFormat=dd/MM/yyyy}"/>
                <DataGridTemplateColumn Header="Medio de transporte" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Text="{Binding Medio.Icono}" ToolTip="{Binding Medio.Nombre}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Panel de detalle -->
        <Border x:Name="panelDetalle" Grid.Row="2" Margin="20,10,20,20" Padding="20" Background="White" CornerRadius="10"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Visibility="Collapsed">
            <DockPanel>
                <Button Click="Button_Click_Volver" Content="← Volver a la lista" DockPanel.Dock="Bottom"
                        HorizontalAlignment="Left" Margin="0,15,0,0" Padding="14,8"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="tbDetalleTrayecto" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>