<Window x:Class="Proyecto_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proyecto_1"
        Loaded="Window_Loaded" Title="Buscador de Trayectos" Height="600" Width="1000"
        WindowState="Maximized" Background="#121417" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#3B82F6"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryPressed" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="Secondary" Color="#2D333B"/>
        <SolidColorBrush x:Key="SecondaryHover" Color="#373E47"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#1E2126"/>
        <SolidColorBrush x:Key="InputBackground" Color="#262A30"/>
        <SolidColorBrush x:Key="BorderColor" Color="#323741"/>
        <SolidColorBrush x:Key="TextColor" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="MutedText" Color="#9CA3AF"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Secondary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SecondaryHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="6,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E3A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#1E2126"/>
            <Setter Property="AlternatingRowBackground" Value="#252930"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2F343D"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#111317"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E3A8A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Border Grid.Row="0" Background="#1A1D21" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="24,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7C0;" FontSize="20"
                               Foreground="{StaticResource Primary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Buscador de Trayectos" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Sign in" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Button_Click_Sign"/>
                    <Button Content="Log in" Click="Button_Click_Log"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Panel de búsqueda compacto -->
        <Border Grid.Row="1" Margin="24,20,24,12" Padding="24,18" Background="{StaticResource PanelBackground}"
                CornerRadius="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
            <Grid MaxWidth="960">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Origen -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Origen" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtOrigen" TextChanged="txtOrigen_TextChanged" Margin="0,0,0,10"/>
                    <Popup x:Name="popupSugerencias" Placement="Bottom" StaysOpen="False"
                           PlacementTarget="{Binding ElementName=txtOrigen}">
                        <ListBox x:Name="lstSugerencias" SelectionChanged="lstSugerencias_SelectionChanged"
                                 MaxHeight="150" DisplayMemberPath="Nombre"
                                 Width="{Binding ActualWidth, ElementName=txtOrigen}"/>
                    </Popup>
                    <TextBlock Text="Hora de salida" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cboHoraSalida"/>
                </StackPanel>

                <!-- Separador visual -->
                <TextBlock Grid.Column="1" Text="→" FontSize="20" Foreground="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="20,0"/>

                <!-- Destino -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Destino" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtDestino" TextChanged="txtDestino_TextChanged" Margin="0,0,0,10"/>
                    <Popup x:Name="popupSugerencias2" Placement="Bottom" StaysOpen="False"
                           PlacementTarget="{Binding ElementName=txtDestino}">
                        <ListBox x:Name="lstSugerencias2" SelectionChanged="lstSugerencias2_SelectionChanged"
                                 MaxHeight="150" DisplayMemberPath="Nombre"
                                 Width="{Binding ActualWidth, ElementName=txtDestino}"/>
                    </Popup>
                    <TextBlock Text="Hora de llegada" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cboLlegada"/>
                </StackPanel>

                <!-- Botón Buscar -->
                <Button Grid.Column="3" Content="Buscar" Click="Button_Click"
                        VerticalAlignment="Bottom" Height="34" Margin="24,0,0,0" Padding="28,0"/>
            </Grid>
        </Border>

        <!-- Tabla de resultados -->
        <DataGrid x:Name="dgTrayecto" Grid.Row="2" Margin="24,8,24,24" AutoGenerateColumns="False" Visibility="Visible">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="54">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource IconButton}" Background="Transparent"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Click="Button_Click_info">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="16"
                                           Foreground="{StaticResource Primary}"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Identificador" Width="110" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="Nombre" Width="2*" Binding="{Binding Nombre}"/>
                <DataGridTextColumn Header="Fecha de creación" Width="*" Binding="{Binding FechaCreacion, StringFormat=dd/MM/yyyy}"/>
                <DataGridTemplateColumn Header="Medio de transporte" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Text="{Binding Medio.Icono}" ToolTip="{Binding Medio.Nombre}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Panel de detalle -->
        <Border x:Name="panelDetalle" Grid.Row="2" Margin="24,8,24,24" Padding="24"
                Background="{StaticResource PanelBackground}" CornerRadius="10"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Visibility="Collapsed">
            <DockPanel>
                <Button Click="Button_Click_Volver" Content="← Volver a la lista"
                        Style="{StaticResource SecondaryButton}" DockPanel.Dock="Bottom"
                        HorizontalAlignment="Left" Margin="0,16,0,0" Padding="14,8"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="tbDetalleTrayecto" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>