<Window x:Class="Proyecto_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proyecto_1"
        Loaded="Window_Loaded" Title="MainWindow" Height="450" Width="800">
    <Grid Margin="0,6,0,-6">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="Log in" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" Click="Button_Click_Log"/>
            <Button Content="Sign in" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" Click="Button_Click_Sign"/>
        </StackPanel>
        
        <Grid Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="10">
                <TextBlock Text="Origen" HorizontalAlignment="Center" Margin="10"/>
                <TextBox TextChanged="txtOrigen_TextChanged" x:Name="txtOrigen" Width="150" HorizontalAlignment="Center"
                 Margin="10"/>
                <Popup x:Name="popupSugerencias" Placement="Bottom" StaysOpen="False"
               PlacementTarget="{Binding ElementName=txtOrigen}">
                    <ListBox SelectionChanged="lstSugerencias_SelectionChanged" x:Name="lstSugerencias" MaxHeight="150"
                   DisplayMemberPath="Nombre" Width="{Binding ActualWidth, ElementName=txtOrigen}"/>
                </Popup>
                <ComboBox x:Name="cboHoraSalida" Width="150" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="10">
                <TextBlock Text="Destino" HorizontalAlignment="Center" Margin="10"/>
                <TextBox TextChanged="txtDestino_TextChanged" x:Name="txtDestino" Width="150" HorizontalAlignment="Center"
                 Margin="10"/>
                <Popup x:Name="popupSugerencias2" Placement="Bottom" StaysOpen="False"
               PlacementTarget="{Binding ElementName=txtDestino}">
                    <ListBox SelectionChanged="lstSugerencias2_SelectionChanged" x:Name="lstSugerencias2" MaxHeight="150"
                   DisplayMemberPath="Nombre" Width="{Binding ActualWidth, ElementName=txtDestino}"/>
                </Popup>
                <ComboBox x:Name="cboLlegada" Width="150" HorizontalAlignment="Center"/>
            </StackPanel>
            <Button Click="Button_Click" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Margin="10" Height="20">Buscar</Button>
        </Grid>
        <DataGrid x:Name="dgTrayecto" Grid.Row="2" Margin="10" AutoGenerateColumns="False" Visibility="Visible">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Button_Click_info">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="16"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Identificador" Width="80" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="Nombre" Width="*" Binding="{Binding Nombre}"/>
                <DataGridTextColumn Header="Nombre de Creación" Width="*" Binding="{Binding FechaCreacion, StringFormat=dd/MM/yyyy}"/>
                <DataGridTemplateColumn Header="Medio de transporte" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Text="{Binding Medio.Icono}" ToolTip="{Binding Medio.Nombre}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Border x:Name="panelDetalle" Grid.Row="2" Margin="10" Padding="15" BorderBrush="Gray" BorderThickness="1"
            Visibility="Collapsed">
            <DockPanel>
                <Button Click="Button_Click_Volver" Content="← Volver a la lista" DockPanel.Dock="Bottom"
                HorizontalAlignment="Left" Margin="0,15,0,0" Padding="10,5"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="tbDetalleTrayecto" TextWrapping="Wrap" FontSize="14"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>