<Window x:Class="Proyecto_1.VentanaEditorEscojer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proyecto_1"
        mc:Ignorable="d"
        Title="VentanaEditorEscojer" Height="450" Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- COLUMNA IZQUIERDA: TABLAS -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Tabla Paradas -->
            <Border Grid.Row="0" BorderBrush="Black" BorderThickness="2" Margin="10,10,10,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Paradas" Margin="10,5,10,0" FontWeight="SemiBold"/>
                    <DataGrid Grid.Row="1" x:Name="dtgParadas" Margin="10"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"/>
                </Grid>
            </Border>

            <Button Grid.Row="1" Content="Eliminar" Height="30" Width="100" Margin="0,5,0,5" HorizontalAlignment="Center"/>

            <!-- Tabla Trayectos -->
            <Border Grid.Row="2" BorderBrush="Black" BorderThickness="2" Margin="10,5,10,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Trayectos" Margin="10,5,10,0" FontWeight="SemiBold"/>
                    <DataGrid Grid.Row="1" x:Name="dtgTrayectos" Margin="10"
                              MouseDoubleClick="dtgTrayectos_MouseDoubleClick"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"/>
                </Grid>
            </Border>

            <Button Grid.Row="3" Content="Eliminar" Height="30" Width="100" Margin="0,5,0,10" HorizontalAlignment="Center"
                    Click="Button_Click_Eliminar"/>
        </Grid>

        <!-- COLUMNA DERECHA: FORMULARIOS -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Formulario Paradas -->
            <Border Grid.Row="0" BorderBrush="Black" BorderThickness="2" Margin="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Hora llegada" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtHoraLlegada" Width="120"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Hora salida" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtHoraSalida" Width="120"/>
                        </StackPanel>
                    </Grid>

                    <Button Grid.Row="1" Content="Guardar" Width="100" Height="30" Margin="10" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" BorderBrush="Black" BorderThickness="2" Margin="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" VerticalAlignment="Center" Margin="15,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,6"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtNombre" FontSize="14" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Origen:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,6"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtOrigen" FontSize="14" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Destino:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,6"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtDestino" FontSize="14" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Medio Transporte:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cboMedioTransporte" FontSize="14"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="Insertar" Width="100" Margin="10" HorizontalAlignment="Center" Grid.Column="0" Click="Button_Click_Insertar"/>
                        <Button Content="Modificar" Width="100" Margin="10" HorizontalAlignment="Center" Grid.Column="2" Click="Button_Click_Modificar"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>