<Window x:Class="Proyecto_1.VentanaEditorParada"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proyecto_1"
        mc:Ignorable="d"
        Title="VentanaEditorParada" Height="450" Width="800">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="Black" BorderThickness="2" Padding="10" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <RadioButton Content="Pendiente de validación" Grid.Column="0" HorizontalAlignment="Center"/>
                    <RadioButton Content="Visible" Grid.Column="1" HorizontalAlignment="Center"/>
                    <RadioButton Content="Invisible" Grid.Column="2" HorizontalAlignment="Center"/>
                </Grid>

                <DataGrid x:Name="dtgParadas" Grid.Row="2" Margin="10"/>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="Gestionar" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="Editar" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <Border BorderBrush="Black" BorderThickness="2" Padding="10" Grid.Column="1" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Nombre" Margin="10"/>
                            <TextBox HorizontalAlignment="Center" VerticalAlignment="Center" Width="100"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Origen" Margin="10"/>
                            <TextBox HorizontalAlignment="Center" VerticalAlignment="Center" Width="100"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Destino" Margin="10"/>
                            <TextBox HorizontalAlignment="Center" VerticalAlignment="Center" Width="100"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Medio" Margin="10"/>
                            <TextBox HorizontalAlignment="Center" VerticalAlignment="Center" Width="100"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Salida" Margin="10"/>
                            <TextBox HorizontalAlignment="Center" VerticalAlignment="Center" Width="100"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Llegada" Margin="10"/>
                            <TextBox HorizontalAlignment="Center" VerticalAlignment="Center" Width="100"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Button Content="Crear" HorizontalAlignment="Center" VerticalAlignment="Center" Height="80" Width="80"/>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
