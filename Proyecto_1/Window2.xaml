<Window x:Class="Proyecto_1.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proyecto_1"
        mc:Ignorable="d"
        Title="Window2" Height="450" Width="500"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Registrarse" FontSize="50" HorizontalAlignment="Center"/>

        <Border BorderBrush="Black" BorderThickness="2" Margin="10" Grid.Row="1">
            <Grid>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre:" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,10" FontSize="16"/>
                    <TextBox x:Name="txtNombre" Grid.Row="0" Grid.Column="1" Height="30" Width="200" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,10" FontSize="16"/>
                    <TextBox x:Name="txtMail" Grid.Row="1" Grid.Column="1" Height="30" Width="200" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Contraseña:" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,10" FontSize="16"/>
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                        <PasswordBox x:Name="txtPwd" Height="30" Width="200"
                            VerticalContentAlignment="Center" Padding="0,0,30,0"
                            PasswordChanged="TxtPwd_PasswordChanged"/> 

                        <TextBox x:Name="txtPwdVisible" Height="30" Width="200"
                            VerticalContentAlignment="Center" Padding="0,0,30,0"
                            Visibility="Collapsed"
                            TextChanged="TxtPwdVisible_TextChanged"/>

                        <ToggleButton x:Name="btnVerPwd" Content="👁" Width="26" Height="26"
                            HorizontalAlignment="Right" Margin="0,0,2,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Checked="BtnVerPwd_Changed" Unchecked="BtnVerPwd_Changed"/>
                    </Grid>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Confirmar contraseña:" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="16"/>
                    <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                        <PasswordBox x:Name="txtConfirmPwd" Height="30" Width="200"
                            VerticalContentAlignment="Center" Padding="0,0,30,0"
                            PasswordChanged="TxtConfirmPwd_PasswordChanged"/>

                        <TextBox x:Name="txtConfirmPwdVisible" Height="30" Width="200"
                            VerticalContentAlignment="Center" Padding="0,0,30,0"
                            Visibility="Collapsed"
                            TextChanged="TxtConfirmPwdVisible_TextChanged"/>

                        <ToggleButton x:Name="btnVerConfirmPwd" Content="👁" Width="26" Height="26"
                            HorizontalAlignment="Right" Margin="0,0,2,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Checked="BtnVerConfirmPwd_Changed" Unchecked="BtnVerConfirmPwd_Changed"/>
                    </Grid>

                    <Grid Grid.Row="4" Grid.ColumnSpan="2" Height="45">
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock x:Name="txtErrorMail" Text="El mail no sigue el formato correcto." Foreground="Red" HorizontalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock x:Name="txtError2Pwd" Text="Las contraseñas no coinciden." Foreground="Red" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="280" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Button Grid.Row="2" Content="Registrarse" HorizontalAlignment="Center" VerticalAlignment="Center" Height="40" Width="70" Click="Button_Click"/>
    </Grid>
</Window>
