<Window x:Class="Proyecto_1.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proyecto_1"
        mc:Ignorable="d"
        Title="Window3" Height="450" Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Iniciar sesión" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Border BorderBrush="Black" BorderThickness="2" Margin="10" Grid.Row="1">
            <Grid>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Email:" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,10" FontSize="16"/>
                    <TextBox x:Name="txtMail" Grid.Row="0" Grid.Column="1" Height="30" Width="200" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Contraseña:" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,10" FontSize="16"/>
                    <TextBox x:Name="txtPwd" Grid.Row="1" Grid.Column="1" Height="30" Width="200" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <Grid Grid.Row="2" Grid.ColumnSpan="2" Height="55">
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock x:Name="txtErrorUsr" Text="El usuario no existe." Foreground="Red" HorizontalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock x:Name="txtErrorPwd" Text="Contraseña incorrecta." Foreground="Red" HorizontalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock x:Name="txtErrorDB" Text="El correo y la contraseña no coinciden." Foreground="Red" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="280" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Iniciar sesión" Height="40" Width="100" Margin="0,0,15,0" Click="Button_Click"/>
            <Button Content="Registrarse" Height="40" Width="100" Click="Button_Click_1"/>
        </StackPanel>
    </Grid>
</Window>