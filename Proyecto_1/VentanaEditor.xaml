<Window x:Class="Proyecto_1.VentanaEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proyecto_1"
        mc:Ignorable="d"
        Title="VentanaEditor" Height="600" Width="1000"
        WindowState="Maximized" Background="#121417" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#3B82F6"/>
        <SolidColorBrush x:Key="Danger" Color="#DC2626"/>
        <SolidColorBrush x:Key="Neutral" Color="#374151"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#1E2126"/>
        <SolidColorBrush x:Key="InputBackground" Color="#262A30"/>
        <SolidColorBrush x:Key="BorderColor" Color="#323741"/>
        <SolidColorBrush x:Key="TextColor" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="MutedText" Color="#9CA3AF"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Danger}"/>
        </Style>
        <Style x:Key="NeutralButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Neutral}"/>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#1E2126"/>
            <Setter Property="AlternatingRowBackground" Value="#252930"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2F343D"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#111317"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E3A8A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1A1D21" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <TextBlock Text="Editor de Trayectos y Paradas" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#xE748;" Style="{StaticResource NeutralButton}" ToolTip="Cambiar usuario"
                            Margin="0,0,10,0" Click="Button_Click_CambiarUsuario"/>
                    <Button Content="&#xE7E8;" Style="{StaticResource DangerButton}" ToolTip="Cerrar sesión"
                            Click="Button_Click_LogOut"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.15*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,12,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="15,12,15,0">
                        <TextBlock Text="Trayectos" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="Doble clic para cargar en el formulario" Foreground="{StaticResource MutedText}"
                                   FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1" x:Name="dtgTrayectos" Margin="12"
                              AutoGenerateColumns="False"
                              MouseDoubleClick="dtgTrayectos_MouseDoubleClick"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="Auto"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Fecha Creación" Binding="{Binding FechaCreacion, StringFormat=dd/MM/yyyy}" Width="Auto"/>
                            <DataGridCheckBoxColumn Header="Validado" Binding="{Binding Validado}" Width="Auto"/>
                            <DataGridTextColumn Header="Medio" Binding="{Binding Medio.Nombre}" Width="Auto"/>
                            <DataGridTextColumn Header="Origen" Binding="{Binding Origen.Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Destino" Binding="{Binding Destino.Nombre}" Width="*"/>
                            <DataGridTemplateColumn Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="&#xE74D;" Style="{StaticResource DangerButton}"
                                                ToolTip="Eliminar trayecto"
                                                Width="26" Height="24" FontSize="13"
                                                Click="Button_Click_Eliminar_Trayectos"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Panel}" Margin="0,0,0,8" Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Gestión de Trayecto" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Nombre" FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtNombre" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Origen" FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtOrigen"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Destino" FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtDestino"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Medio de Transporte" FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cboMedioTransporte"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="&#xE894;" Style="{StaticResource NeutralButton}" ToolTip="Limpiar campos"
                                Margin="0,0,8,0" Click="Button_Click_Limpiar_Campos_Trayecto"/>
                        <Button Content="&#xE70F;" ToolTip="Modificar trayecto"
                                Margin="0,0,8,0" Click="Button_Click_Modificar"/>
                        <Button Content="&#xE710;" ToolTip="Insertar trayecto"
                                Click="Button_Click_Insertar"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Panel}" Margin="0,8,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="15,12,15,0">
                        <TextBlock Text="Paradas" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="Doble clic para editar horarios" Foreground="{StaticResource MutedText}"
                                   FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1" x:Name="dtgParadas" Margin="12"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              MouseDoubleClick="dtgParadas_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Trayecto" Binding="{Binding Id_trayecto.Id}" Width="Auto"/>
                            <DataGridTextColumn Header="Id Estación" Binding="{Binding IdEstacion}" Width="Auto"/>
                            <DataGridTextColumn Header="Orden" Binding="{Binding Orden}" Width="Auto"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Hora Llegada" Binding="{Binding HoraLlegada, StringFormat=HH:mm}" Width="Auto"/>
                            <DataGridTextColumn Header="Hora Salida" Binding="{Binding HoraSalida, StringFormat=HH:mm}" Width="Auto"/>
                            <DataGridTextColumn Header="Hora Paso" Binding="{Binding HoraPaso, StringFormat=HH:mm}" Width="Auto"/>
                            <DataGridTemplateColumn Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="&#xE74D;" Style="{StaticResource DangerButton}"
                                                ToolTip="Eliminar parada"
                                                Width="26" Height="24" FontSize="13"
                                                Click="Button_Click_Eliminar_Paradas"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Panel}" Margin="0,8,0,0" Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Gestión de Parada" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Hora llegada (HH:mm)" FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtHoraLlegada"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hora salida (HH:mm)" FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtHoraSalida"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="&#xE894;" Style="{StaticResource NeutralButton}" ToolTip="Limpiar campos"
                                Margin="0,0,8,0" Click="Button_Click_Limpiar_Campos_Parada"/>
                        <Button Content="&#xE70F;" ToolTip="Modificar parada"
                                Margin="0,0,8,0" Click="Button_Click_Modificar_Paradas"/>
                        <Button Content="&#xE710;" ToolTip="Insertar parada"
                                Click="Button_Click_Insertar_Paradas"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>