<Window x:Class="Proyecto_1.VentanaEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proyecto_1"
        mc:Ignorable="d"
        Title="VentanaEditor" Height="450" Width="800"
        WindowState="Maximized" Background="#F3F5F9" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- Colores -->
        <SolidColorBrush x:Key="Primary" Color="#2563EB"/>
        <SolidColorBrush x:Key="Danger" Color="#DC2626"/>
        <SolidColorBrush x:Key="Neutral" Color="#475569"/>
        <SolidColorBrush x:Key="BorderColor" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="TextColor" Color="#1F2937"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>

        <!-- Botones de icono (estilo base: azul) -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Danger}"/>
        </Style>
        <Style x:Key="NeutralButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Neutral}"/>
        </Style>

        <!-- Paneles -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Button Content="&#xE7E8;" Style="{StaticResource NeutralButton}" ToolTip="Cerrar sesión"
                    Margin="10" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Button_Click_LogOut"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Columna izquierda -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Panel}" Margin="15,15,15,5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Paradas" Margin="15,10,10,0" FontWeight="SemiBold" FontSize="15"/>
                        <DataGrid Grid.Row="1" x:Name="dtgParadas" Margin="12"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  MouseDoubleClick="dtgParadas_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Trayecto" Binding="{Binding Id_trayecto.Id}" />
                                <DataGridTextColumn Header="Id Estación" Binding="{Binding IdEstacion}" />
                                <DataGridTextColumn Header="Orden" Binding="{Binding Orden}" />
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" />
                                <DataGridTextColumn Header="Hora Llegada" Binding="{Binding HoraLlegada, StringFormat=HH:mm}" />
                                <DataGridTextColumn Header="Hora Salida" Binding="{Binding HoraSalida, StringFormat=HH:mm}" />
                                <DataGridTextColumn Header="Hora Paso" Binding="{Binding HoraPaso, StringFormat=HH:mm}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Button Grid.Row="1" Content="&#xE74D;" Style="{StaticResource DangerButton}" ToolTip="Eliminar parada"
                        Margin="0,5,0,5" HorizontalAlignment="Center" VerticalAlignment="Top" Click="Button_Click_Eliminar_Paradas"/>

                <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="15,5,15,5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Trayectos" Margin="15,10,10,0" FontWeight="SemiBold" FontSize="15"/>
                        <DataGrid Grid.Row="1" x:Name="dtgTrayectos" Margin="12"
                                  AutoGenerateColumns="False"
                                  MouseDoubleClick="dtgTrayectos_MouseDoubleClick"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" />
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" />
                                <DataGridTextColumn Header="Fecha Creación" Binding="{Binding FechaCreacion, StringFormat=dd/MM/yyyy}" />
                                <DataGridCheckBoxColumn Header="Validado" Binding="{Binding Validado}" />
                                <DataGridTextColumn Header="Medio" Binding="{Binding Medio.Nombre}" />
                                <DataGridTextColumn Header="Origen" Binding="{Binding Origen.Nombre}" />
                                <DataGridTextColumn Header="Destino" Binding="{Binding Destino.Nombre}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Button Grid.Row="3" Content="&#xE74D;" Style="{StaticResource DangerButton}" ToolTip="Eliminar trayecto"
                        Margin="0,5,0,15" HorizontalAlignment="Center"
                        Click="Button_Click_Eliminar_Trayectos"/>
            </Grid>

            <!-- Columna derecha -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Formulario de paradas -->
                <Border Grid.Row="0" Style="{StaticResource Panel}" Margin="15,15,15,5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="Hora llegada" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBox x:Name="txtHoraLlegada" Width="120"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="Hora salida" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBox x:Name="txtHoraSalida" Width="120"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="&#xE710;" ToolTip="Insertar parada" Margin="10" HorizontalAlignment="Center" Click="Button_Click_Insertar_Paradas"/>
                            <Button Grid.Column="1" Content="&#xE70F;" ToolTip="Modificar parada" Margin="10" HorizontalAlignment="Center" Click="Button_Click_Modificar_Paradas"/>
                            <Button Grid.Column="2" Content="&#xE894;" Style="{StaticResource NeutralButton}" ToolTip="Limpiar campos" Margin="10" HorizontalAlignment="Center" Click="Button_Click_Limpiar_Campos_Parada"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Formulario de trayectos -->
                <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="15,5,15,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" VerticalAlignment="Center" Margin="20,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,8"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtNombre" FontSize="14" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Origen:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,8"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtOrigen" FontSize="14" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Destino:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,8"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtDestino" FontSize="14" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Medio Transporte:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cboMedioTransporte" FontSize="14"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Content="&#xE710;" ToolTip="Insertar trayecto" Margin="10" HorizontalAlignment="Center" Grid.Column="0" Click="Button_Click_Insertar"/>
                            <Button Content="&#xE70F;" ToolTip="Modificar trayecto" Margin="10" HorizontalAlignment="Center" Grid.Column="1" Click="Button_Click_Modificar"/>
                            <Button Content="&#xE894;" Style="{StaticResource NeutralButton}" ToolTip="Limpiar campos" Margin="10" HorizontalAlignment="Center" Grid.Column="2" Click="Button_Click_Limpiar_Campos_Trayecto"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>