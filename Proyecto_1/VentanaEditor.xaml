<Window x:Class="Proyecto_1.VentanaEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proyecto_1"
        mc:Ignorable="d"
        Title="VentanaEditor" Height="450" Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="Black" BorderThickness="2" Margin="10,10,10,5" CornerRadius="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Paradas" Margin="10,5,10,0" FontWeight="SemiBold"/>
                    <DataGrid Grid.Row="1" x:Name="dtgParadas" Margin="10"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      MouseDoubleClick="dtgParadas_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Trayecto" Binding="{Binding Idtrayecto.Id}" />
                            <DataGridTextColumn Header="Id Estación" Binding="{Binding IdEstacion}" />
                            <DataGridTextColumn Header="Orden" Binding="{Binding Orden}" />
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" />
                            <DataGridTextColumn Header="Hora Llegada" Binding="{Binding HoraLlegada, StringFormat=HH:mm}" />
                            <DataGridTextColumn Header="Hora Salida" Binding="{Binding HoraSalida, StringFormat=HH:mm}" />
                            <DataGridTextColumn Header="Hora Paso" Binding="{Binding HoraPaso, StringFormat=HH:mm}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Button Grid.Row="1" Content="Eliminar" Height="30" Width="100" Margin="0,5,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Click="Button_Click_Eliminar_Paradas"/>

            <Border Grid.Row="2" BorderBrush="Black" BorderThickness="2" Margin="10,5,10,5" CornerRadius="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Trayectos" Margin="10,5,10,0" FontWeight="SemiBold"/>
                    <DataGrid Grid.Row="1" x:Name="dtgTrayectos" Margin="10"
                      AutoGenerateColumns="False"
                      MouseDoubleClick="dtgTrayectos_MouseDoubleClick"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" />
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" />
                            <DataGridTextColumn Header="Fecha Creación" Binding="{Binding FechaCreacion, StringFormat=dd/MM/yyyy}" />
                            <DataGridCheckBoxColumn Header="Validado" Binding="{Binding Validado}" />

                            <DataGridTextColumn Header="Medio" Binding="{Binding Medio.Nombre}" />
                            <DataGridTextColumn Header="Origen" Binding="{Binding Origen.Nombre}" />
                            <DataGridTextColumn Header="Destino" Binding="{Binding Destino.Nombre}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Button Grid.Row="3" Content="Eliminar" Height="30" Width="100" Margin="0,5,0,10" HorizontalAlignment="Center"
                    Click="Button_Click_Eliminar_Trayectos"/>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="Black" BorderThickness="2" Margin="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Hora llegada" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtHoraLlegada" Width="120"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Hora salida" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtHoraSalida" Width="120"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Insertar" Width="100" Height="30" Margin="10" HorizontalAlignment="Center" Click="Button_Click_Insertar_Paradas"/>
                        <Button Grid.Column="1" Content="Modificar" Width="100" Height="30" Margin="10" HorizontalAlignment="Center" Click="Button_Click_Modificar_Paradas"/>
                        <Button Grid.Column="2" Content="Limpiar campos" Width="100" Height="30" Margin="10" HorizontalAlignment="Center" Click="Button_Click_Limpiar_Campos_Parada"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" BorderBrush="Black" BorderThickness="2" Margin="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" VerticalAlignment="Center" Margin="15,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,6"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtNombre" FontSize="14" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Origen:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,6"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtOrigen" FontSize="14" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Destino:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,6"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtDestino" FontSize="14" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Medio Transporte:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cboMedioTransporte" FontSize="14"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="Insertar" Width="100" Margin="10" HorizontalAlignment="Center" Grid.Column="0" Click="Button_Click_Insertar"/>
                        <Button Content="Modificar" Width="100" Margin="10" HorizontalAlignment="Center" Grid.Column="1" Click="Button_Click_Modificar"/>
                        <Button Content="Limpiar campos" Width="100" Margin="10" HorizontalAlignment="Center" Grid.Column="2" Click="Button_Click_Limpiar_Campos_Trayecto"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>